# MongoDB Atlas connection string (used by config/db.js)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>

# Auth
JWT_SECRET=change-me

# Gmail (used for outgoing notification emails, src/config/gmailConfig.js)
GMAIL_USER=your-app@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Optional: unused today (Prisma/Supabase is scaffolded but not wired into server.js)
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db-name>
