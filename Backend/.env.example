PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/iut-feedback
DATABASE_URL=postgresql://user:password@localhost:5432/iut_comm_db
JWT_SECRET=your_super_secret_jwt_key
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
NODE_ENV=development
# Deployed frontend origin, needed in production so CORS allows it (e.g. https://your-app.vercel.app)
FRONTEND_URL=

# Firebase Admin SDK (Project Settings -> Service Accounts -> Generate new private key).
# Used to verify Google sign-in tokens from the frontend. Only needed if not using
# a local firebase.admin.json file instead (see firebase.js).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
